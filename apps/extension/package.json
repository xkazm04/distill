{
  "name": "@distill/extension",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "build": "vite build && vite build --config vite.content.config.ts",
    "e2e": "npm run build:e2e && tsc -p e2e && playwright test -c e2e/playwright.config.ts",
    "build:public": "vite build --mode public && vite build --config vite.content.config.ts --mode public",
    "build:e2e": "vite build --mode e2e && vite build --config vite.content.config.ts --mode e2e"
  },
  "dependencies": {
    "@distill/engine": "*",
    "@distill/web": "*",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/fredoka": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "happy-dom": "^21.0.4",
    "playwright": "1.65.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
