{
  "manifest_version": 3,
  "name": "Distill",
  "version": "0.1.0",
  "description": "Only what matters on the page: a clear reading view and an English step-by-step guide for forms. Your typed answers stay on your device.",
  "minimum_chrome_version": "138",
  "action": {
    "default_title": "Open Distill",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "storage",
    "nativeMessaging"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
